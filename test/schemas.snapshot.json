    "properties": {
      "hour": {
        "maximum": 23,
        "minimum": 0,
        "type": "integer"
      },
      "message": {
        "type": "string"
      },
      "minute": {
        "maximum": 59,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "hour",
      "minute"
    ],
    "type": "object"
