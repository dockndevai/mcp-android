# --- Connection -------------------------------------------------------------
# Path to the adb binary (brew install android-platform-tools).
ANDROID_ADB_PATH=adb
# Target device serial from `adb devices`. Empty = the only connected device.
ANDROID_SERIAL=
ANDROID_TIMEOUT_MS=20000

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
ANDROID_MODE=read-only
# Comma-separated package allowlist for launch/uninstall/clear. Empty = all.
ANDROID_PACKAGE_ALLOWLIST=
# Packages that can be launched/inspected but never uninstalled or data-cleared.
ANDROID_PROTECTED_PACKAGES=com.android.settings,com.android.systemui,com.google.android.gms
# install_apk / uninstall_app / clear_app_data require this in addition to admin mode.
ANDROID_ALLOW_INSTALL=false
# run_shell (arbitrary adb shell) requires this in addition to admin mode.
ANDROID_ALLOW_SHELL=false
# Validate + log write/admin actions without executing them.
ANDROID_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
ANDROID_AUDIT_LOG=true
# Refuse destructive ops when the client cannot show a human approval prompt (instead of trusting the flags alone).
ANDROID_REQUIRE_HUMAN_APPROVAL=false
